<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Hai mốc chiết khấu lấy từ file tính giá của nghiệp vụ, sheet "CK GD2 SH".
         Cả hai đều là loại "Công thức % tính lại tổng giá" (percent_recalc):
         chỉ trừ vào giá bán chưa tiền sử dụng đất, TSDĐ giữ nguyên, còn VAT 10%
         và quỹ bảo trì 0,5% được tính lại trên giá nhà mới.

         Hai CK này thuộc HAI MỐC KHÁC NHAU (A và C) nên NHÂN CHUỖI: CK cho
         thuê 8% ở mốc C tính trên giá đã trừ 7,5% của mốc A, cho ra
         0,925 × 0,92 = 0,851 (giảm 14,90%) chứ KHÔNG phải 7,5% + 8% = 15,5%.

         Ngược lại, nhiều CK CÙNG MỘT MỐC thì CỘNG GỘP phần trăm: hai chương
         trình 1% cùng ở mốc A = 2% trên cùng một giá, không phải 0,99 × 0,99.
         Thứ tự nhân chuỗi luôn là A -> B -> C, không phụ thuộc sequence;
         sequence chỉ dùng để xếp thứ tự hiển thị trong cùng một mốc.

         product_categ_ids để trống = áp cho mọi danh mục. Gán danh mục cụ thể
         nếu chỉ muốn áp cho một loại sản phẩm.

         "Mốc áp dụng" (apply_stage) quyết định CK bị trừ ở đâu trên LỊCH THANH TOÁN:
           ky_hop_dong (A) -> trừ thẳng vào đợt Ký hợp đồng
           spread      (B) -> chia đều từ đợt 4 đến đợt Bàn giao nhà
           giao_nha    (C) -> trừ thẳng vào đợt Bàn giao nhà
         Số tiền trừ vào đợt chỉ là phần giá nhà chưa TSDĐ bị cắt; VAT và quỹ bảo
         trì không trừ theo đợt mà được tính lại từ giá mới rồi đưa lên lịch. -->

    <!-- 1. Mốc ký HĐMB — chiết khấu ghi trong phụ lục hợp đồng -->
    <record id="discount_ck_75_phu_luc" model="product.discount.config">
        <field name="name">CK 7,5% (phụ lục)</field>
        <field name="sequence">10</field>
        <field name="discount_type">percent_recalc</field>
        <field name="qty">7.5</field>
        <field name="discount_value">0</field>
        <field name="apply_stage">ky_hop_dong</field>
        <field name="active" eval="True"/>
    </record>

    <!-- 2. Mốc bàn giao nhà — chiết khấu cho thuê, tính trên giá đã trừ CK 7,5% -->
    <record id="discount_ck_cho_thue_8" model="product.discount.config">
        <field name="name">CK cho thuê 8%</field>
        <field name="sequence">20</field>
        <field name="discount_type">percent_recalc</field>
        <field name="qty">8</field>
        <field name="discount_value">0</field>
        <field name="apply_stage">giao_nha</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
