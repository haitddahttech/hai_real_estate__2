<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout_real_estate_site_plan" name="Main layout" inherit_id="website.layout">
        <!-- Use the project favicon for every public page rendered by this module. -->
        <xpath expr="//t[@t-set='x_icon']" position="attributes">
            <attribute name="t-value">'/real_estate_site_plan/static/src/img/favicon.svg'</attribute>
        </xpath>

        <!-- Page options -->
        <xpath expr="//div[hasclass('o_frontend_to_backend_buttons')]" position="replace">
            <div class="o_frontend_to_backend_buttons d-flex">
                <a href="/odoo"
                   class="o_frontend_to_backend_apps_btn fa fa-th d-flex align-items-center justify-content-center text-decoration-none"
                   >
                </a>
            </div>
        </xpath>
    </template>

    <!-- =====================================================================
         Hồng Hạc City — Homepage (full-screen scroll)
         Hero video → 7 section ảnh nổi bật → card dự án → footer brand
         Bộ nhận diện: honghac_brand_guidelines_skill.md
         ===================================================================== -->
    <template id="portal_landing_page" name="Real Estate Landing Page">
        <t t-call="website.layout">
            <!-- Ẩn footer mặc định của Odoo (trang chủ đã có footer brand hh-footer riêng) -->
            <t t-set="no_footer" t-value="True"/>
            <div id="wrap">
                <div class="hh-home">

                    <!-- ============ 1) HERO VIDEO ============ -->
                    <section class="hh-section-full hh-hero hh-snap">
                        <video class="hh-hero__video"
                               autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline"
                               preload="auto"
                               poster="/real_estate_site_plan/static/src/img/home/hero-poster.jpg">
                            <source src="/real_estate_site_plan/static/src/video/hero.webm" type="video/webm"/>
                            <source src="/real_estate_site_plan/static/src/video/hero.mp4" type="video/mp4"/>
                        </video>
                        <div class="hh-hero__content">
                            <a href="#hh-projects" class="hh-hero__cta reveal">
                                <i class="fa fa-map-marker"/> Khám Phá Dự Án
                            </a>
                        </div>
                        <a href="#hh-map" class="hh-scroll-cue" aria-label="Cuộn xuống">
                            <i class="fa fa-angle-down"/>
                        </a>
                    </section>

