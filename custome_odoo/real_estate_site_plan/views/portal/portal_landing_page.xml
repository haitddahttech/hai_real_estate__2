<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout_real_estate_site_plan" name="Main layout" inherit_id="website.layout">
        <!-- Use the project favicon for every public page rendered by this module. -->
        <xpath expr="//t[@t-set='x_icon']" position="attributes">
            <attribute name="t-value">'/real_estate_site_plan/static/src/img/favicon.svg'</attribute>
        </xpath>

        <!-- Page options -->
        <xpath expr="//div[hasclass('o_frontend_to_backend_buttons')]" position="replace">
            <div class="o_frontend_to_backend_buttons d-flex">
                <a href="/odoo"
                   class="o_frontend_to_backend_apps_btn fa fa-th d-flex align-items-center justify-content-center text-decoration-none"
                   >
                </a>
            </div>
        </xpath>
    </template>

    <!-- =====================================================================
         Hồng Hạc City — Homepage (full-screen scroll)
         Hero video → 7 section ảnh nổi bật → card dự án → footer brand
         Bộ nhận diện: honghac_brand_guidelines_skill.md
         ===================================================================== -->
    <template id="portal_landing_page" name="Real Estate Landing Page">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="hh-home">

                    <!-- ============ 1) HERO VIDEO ============ -->
                    <section class="hh-section-full hh-hero hh-snap">
                        <video class="hh-hero__video"
                               autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline"
                               preload="auto"
                               poster="/real_estate_site_plan/static/src/img/home/hero-poster.jpg">
                            <source src="/real_estate_site_plan/static/src/video/hero.webm" type="video/webm"/>
                            <source src="/real_estate_site_plan/static/src/video/hero.mp4" type="video/mp4"/>
                        </video>
                        <div class="hh-hero__overlay"/>
                        <div class="hh-hero__content">
                            <img class="hh-hero__logo"
                                 src="/real_estate_site_plan/static/src/img/home/logo-white.png"
                                 alt="Hồng Hạc City"
                                 onerror="this.style.display='none'"/>
                            <span class="hh-hero__brandline reveal">Phát triển bởi Phú Mỹ Hưng &amp; Nomura</span>
                            <h1 class="hh-hero__title reveal reveal--delay-1">HỒNG HẠC CITY</h1>
                            <p class="hh-hero__slogan reveal reveal--delay-2">Đô Thị Văn Minh – Cộng Đồng Hạnh Phúc</p>
                            <a href="#hh-projects" class="hh-hero__cta reveal reveal--delay-3">
                                <i class="fa fa-map-marker"/> Khám Phá Dự Án
                            </a>
                        </div>
                        <a href="#hh-feature-1" class="hh-scroll-cue" aria-label="Cuộn xuống">
                            <i class="fa fa-angle-down"/>
                        </a>
                    </section>

                    <!-- ============ 2) ẢNH NỔI BẬT ×7 ============ -->
                    <t t-set="features" t-value="[
                        {'img': 'feature-1.jpg', 'eyebrow': 'Vượng Khởi',        'title': 'Hồng Phát',           'text': 'Khởi đầu sự phồn vinh, tài lộc và cơ hội phát triển bền vững.',                              'align': ''},
                        {'img': 'feature-2.jpg', 'eyebrow': 'Vượng Bền',         'title': 'Hồng Thịnh',          'text': 'Thịnh vượng lâu dài, giá trị gia tăng theo thời gian và di sản trường tồn.',                'align': 'hh-feature--left'},
                        {'img': 'feature-3.jpg', 'eyebrow': 'Vượng An',          'title': 'Hồng Phúc',           'text': 'An lạc trong tâm hồn, cuộc sống khoẻ mạnh và hạnh phúc vẹn tròn.',                           'align': 'hh-feature--right'},
                        {'img': 'feature-4.jpg', 'eyebrow': 'Wellness Living',   'title': 'Chất Sống Xanh',      'text': 'Không gian sống Wellness — ánh sáng tự nhiên, không khí trong lành, cân bằng tâm – thân – trí.', 'align': ''},
                        {'img': 'feature-5.jpg', 'eyebrow': 'Di Sản Kinh Bắc',   'title': 'Chất Sống Kinh Bắc',  'text': 'Đậm đà bản sắc văn hoá Kinh Bắc kết hợp chuẩn mực sống hiện đại.',                          'align': 'hh-feature--left'},
                        {'img': 'feature-6.jpg', 'eyebrow': 'Cộng Đồng Tinh Anh','title': 'Cộng Đồng Hạnh Phúc', 'text': 'Nơi hội tụ những cư dân tinh anh, cùng kiến tạo giá trị sống trường tồn.',                 'align': 'hh-feature--right'},
                        {'img': 'feature-7.jpg', 'eyebrow': 'Eco City',          'title': 'Đô Thị Văn Minh',     'text': 'Đô thị xanh sinh thái tích hợp trọn vẹn tiện ích, nâng đỡ mọi giá trị sống.',              'align': ''}
                    ]"/>
                    <t t-foreach="features" t-as="feat">
                        <section t-attf-id="hh-feature-#{feat_index + 1}"
                                 t-attf-class="hh-section-full hh-feature hh-snap #{feat['align']}">
                            <div class="hh-feature__bg"
                                 t-attf-style="background-image:url('/real_estate_site_plan/static/src/img/home/#{feat['img']}');"/>
                            <div class="hh-feature__overlay"/>
                            <div class="hh-feature__caption">
                                <span class="hh-feature__eyebrow"><t t-esc="feat['eyebrow']"/></span>
                                <h2 class="hh-feature__title"><t t-esc="feat['title']"/></h2>
                                <p class="hh-feature__text"><t t-esc="feat['text']"/></p>
                            </div>
                        </section>
                    </t>

                    <!-- ============ 3) CARD DỰ ÁN ============ -->
                    <section id="hh-projects" class="hh-projects hh-snap">
                        <div class="container">
                            <div class="hh-section-head reveal">
                                <span class="hh-section-head__eyebrow">Bất động sản Wellness &amp; Longevity</span>
                                <h2 class="hh-section-head__title">Dự Án Nổi Bật</h2>
                                <p class="hh-section-head__sub">Khám phá bản đồ tương tác và lựa chọn không gian sống an lành cho gia đình.</p>
                            </div>

                            <t t-set="site_plans" t-value="request.env['site.plan'].sudo().search([('active', '=', True)], limit=9)"/>

                            <t t-if="not site_plans">
                                <div class="hh-empty">
                                    <i class="fa fa-building-o fa-3x mb-3 d-block"/>
                                    <h4>Chưa Có Dự Án</h4>
                                    <p class="mb-0">Hiện tại chưa có dự án nào. Vui lòng quay lại sau!</p>
                                </div>
                            </t>

                            <t t-else="">
                                <div class="row g-4 justify-content-center">
                                    <t t-foreach="site_plans" t-as="site_plan">
                                        <div class="col-lg-4 col-md-6 reveal">
                                            <div class="hh-card">
                                                <div class="hh-card__media">
                                                    <t t-if="site_plan.polygon_count">
                                                        <span class="hh-card__badge"><t t-esc="site_plan.polygon_count"/> lô</span>
                                                    </t>
                                                    <t t-if="site_plan.cover_image">
                                                        <img class="hh-card__img"
                                                             t-attf-src="/web/image/site.plan/#{site_plan.id}/cover_image"
                                                             t-att-alt="site_plan.name"/>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="hh-card__placeholder"><i class="fa fa-building-o"/></div>
                                                    </t>
                                                </div>
                                                <div class="hh-card__body">
                                                    <h3 class="hh-card__title"><t t-esc="site_plan.name"/></h3>
                                                    <p class="hh-card__desc">
                                                        <t t-if="site_plan.description"
                                                           t-esc="site_plan.description[:110] + '…' if len(site_plan.description) > 110 else site_plan.description"/>
                                                        <t t-else="">Khám phá bản đồ chi tiết và lựa chọn lô đất phù hợp với nhu cầu của bạn.</t>
                                                    </p>
                                                    <a t-attf-href="/my/site-plan/#{site_plan.id}" class="hh-card__cta">
                                                        Xem Bản Đồ <i class="fa fa-arrow-right"/>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>

                                <div class="hh-projects__more reveal">
                                    <a href="/my/site-plans" class="hh-btn-outline">
                                        Xem Tất Cả Dự Án <i class="fa fa-arrow-right"/>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </section>

                    <!-- ============ 4) FOOTER BRAND ============ -->
                    <footer class="hh-footer">
                        <div class="container reveal">
                            <div class="hh-footer__title">HỒNG HẠC CITY</div>
                            <div class="hh-footer__brandline">Phú Mỹ Hưng &amp; Nomura</div>
                            <div class="hh-footer__contacts">
                                <span><i class="fa fa-phone"/> 024 3936 2640</span>
                                <span><i class="fa fa-phone"/> 0222 3616 888</span>
                                <a href="https://honghacphumyhung.vn" target="_blank" rel="noopener">
                                    <i class="fa fa-globe"/> honghacphumyhung.vn
                                </a>
                            </div>
                            <hr class="hh-footer__divider"/>
                            <div class="hh-footer__copy">© Hồng Hạc City — Đô Thị Văn Minh, Cộng Đồng Hạnh Phúc.</div>
                        </div>
                    </footer>

                </div>
            </div>
        </t>
    </template>

</odoo>
