<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Create Website Menu Items for Site Plans -->
    <!-- This will be populated dynamically via Python code -->
    <template id="create_site_plan_menus" name="Create Site Plan Menus">
        <!-- Menus will be created programmatically in the controller -->
    </template>

    <!-- Change Logo Link to Landing Page (Robust JS version for Odoo 19) -->
    <template id="site_plan_logo_link" inherit_id="website.layout" priority="50">
        <xpath expr="//div[@id='wrapwrap']" position="after">
            <script type="text/javascript">
                (function() {
                    const updateLogo = () => {
                        const brands = document.querySelectorAll('.navbar-brand');
                        brands.forEach(b => b.setAttribute('href', '/real-estate'));
                    };
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', updateLogo);
                    } else {
                        updateLogo();
                    }
                })();
            </script>
        </xpath>
    </template>

    <!-- Portal Home: Individual Site Plan Menus -->
    <template id="portal_my_home_site_plans" name="Portal My Home : Site Plan Entries" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="site_plans_list">
                <t t-foreach="site_plans_list" t-as="plan">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="title" t-value="plan.name"/>
                        <t t-set="url" t-attf-value="'/my/site-plan/%s' % plan.id"/>
                        <t t-set="placeholder">Bản đồ mặt bằng dự án</t>
                        <t t-set="icon" t-value="'/real_estate_site_plan/static/description/icon_map.svg'"/>
                        <t t-set="count" t-value="plan.polygon_count"/>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
    
    <!-- Website Navbar: ONLY link individual site plans in header, remove other menus -->
    <template id="site_plan_navbar_menus" inherit_id="website.template_header_default" priority="50">
        <!-- 1. Replace default menu loop: chỉ "Trang chủ" + toàn bộ dự án active (top-level, phẳng) -->
        <xpath expr="//t[@t-foreach='website.menu_id.child_id']" position="replace">
            <t t-set="current_path" t-value="request.httprequest.path"/>

            <!-- Trang chủ -->
            <li class="nav-item">
                <a t-attf-class="nav-link #{'active' if current_path in ('/', '/real-estate', '/real-estate/') else ''}"
                   href="/real-estate">Trang chủ</a>
            </li>

            <!-- Toàn bộ dự án đang active -->
            <t t-set="active_site_plans" t-value="request.env['site.plan'].sudo().search([('active', '=', True)])"/>
            <t t-foreach="active_site_plans" t-as="plan">
                <li class="nav-item">
                    <a t-attf-class="nav-link #{'active' if current_path == '/my/site-plan/%s' % plan.id else ''}"
                       t-attf-href="/my/site-plan/#{plan.id}">
                        <t t-esc="plan.name"/>
                    </a>
                </li>
            </t>
        </xpath>
        
        <!-- 2. Keep only Sign In and User Dropdown, remove Search, Social, etc. -->
        <xpath expr="//ul[hasclass('navbar-nav')][hasclass('justify-content-end')]" position="replace">
            <ul class="navbar-nav align-items-center gap-2 flex-shrink-0 justify-content-end ps-3">
                <!-- Sign In -->
                <t t-call="portal.placeholder_user_sign_in"
                    _link_class="'o_nav_link_btn nav-link border px-3'"/>
                
                <!-- Language Switcher -->
                <!-- Language Switcher (Odoo Native) -->
                <t t-call="portal.language_selector">
                    <t t-set="_div_classes" t-value="'nav-item dropdown'"/>
                    <t t-set="_btn_class" t-value="'nav-link dropdown-toggle border-0 d-flex align-items-center gap-1'"/>
                    <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end shadow-sm'"/>
                </t>
                
                <!-- User Dropdown -->
                <t t-call="portal.user_dropdown"
                    _user_name="True"
                    _item_class="'dropdown'"
                    _link_class="'nav-link border-0'"
                    _dropdown_menu_class="'dropdown-menu-end'"/>
            </ul>
            

        </xpath>
    </template>


    <!-- Site Plans List Page — lưới card theo brand Hồng Hạc City -->
    <template id="portal_my_site_plans" name="My Site Plans">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Bản Đồ Dự Án</t>
            </t>

            <t t-if="not site_plans">
                <div class="hh-empty text-center py-5">
                    <i class="fa fa-building-o fa-3x mb-3 d-block"/>
                    <h4>Chưa Có Dự Án</h4>
                    <p class="mb-0">Hiện tại chưa có bản đồ dự án nào. Vui lòng quay lại sau!</p>
                </div>
            </t>

            <t t-if="site_plans">
                <div class="hh-portal-grid">
                    <div class="row g-4">
                        <t t-foreach="site_plans" t-as="site_plan">
                            <div class="col-lg-4 col-md-6">
                                <div class="hh-card">
                                    <a t-attf-href="/my/site-plan/#{site_plan.id}" class="hh-card__media">
                                        <t t-if="site_plan.polygon_count">
                                            <span class="hh-card__badge"><t t-esc="site_plan.polygon_count"/> lô</span>
                                        </t>
                                        <t t-if="site_plan.cover_image">
                                            <img class="hh-card__img"
                                                 t-attf-src="/web/image/site.plan/#{site_plan.id}/cover_image"
                                                 t-att-alt="site_plan.name"/>
                                        </t>
                                        <t t-else="">
                                            <div class="hh-card__placeholder"><i class="fa fa-building-o"/></div>
                                        </t>
                                    </a>
                                    <div class="hh-card__body">
                                        <h3 class="hh-card__title"><t t-esc="site_plan.name"/></h3>
                                        <p class="hh-card__desc">
                                            <t t-if="site_plan.description"
                                               t-esc="site_plan.description[:110] + '…' if len(site_plan.description) > 110 else site_plan.description"/>
                                            <t t-else="">Khám phá bản đồ chi tiết và lựa chọn lô đất phù hợp với nhu cầu của bạn.</t>
                                        </p>
                                        <a t-attf-href="/my/site-plan/#{site_plan.id}" class="hh-card__cta">
                                            Xem Bản Đồ <i class="fa fa-arrow-right"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <div t-if="pager" class="o_portal_pager mt-4 d-flex justify-content-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>


</odoo>
